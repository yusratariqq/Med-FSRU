# ------------------------------------------------------------
# 2. DETERMINISTIC DECODE
# ------------------------------------------------------------
@torch.no_grad()
def decode_fn(model, images, question_ids, question_mask, question_texts):
    """Deterministic beam-search decode. do_sample is always False inside
    model.generate() (see model.py), this wrapper just documents that
    contract at the call site."""
    return model.generate(
        images=images,
        question_ids=question_ids,
        question_mask=question_mask,
        max_length=args.max_answer_len,
        question_texts=question_texts,
    )


def _normalize(text: str) -> str:
    return str(text).strip().lower()


def _zero_visual_fsru_hook(n_img_tokens):
    def _hook(module, inp, out):
        out = out.clone()
        out[:, :n_img_tokens, :] = 0.0
        return out
    return _hook


# ------------------------------------------------------------
# 3. SINGLE-PASS PREDICTION COLLECTION (the actual bug fix)
# ------------------------------------------------------------
@torch.no_grad()
def collect_predictions(model, dataloader, device, max_examples=None):
    """
    Runs inference on every validation example EXACTLY ONCE, both with and
    without the FSRU visual contribution, and caches the results keyed by a
    stable unique id (flat dataset index, plus image path + question text
    for a human-readable cross-check).

    Returns a dict: unique_id -> record, where record contains everything
    needed for both plotting and correctness classification. Because both
    case-study and failure selection draw from this single cache, no
    example can ever be inferred twice, and the two predicates
    (full_correct and not ablated_correct) vs (not full_correct and
    ablated_correct) are mutually exclusive by construction, so the
    resulting success/failure sets are guaranteed disjoint.
    """
    model.eval()
    n_img_tokens = model.vision_encoder.num_tokens

    records = {}
    flat_idx = 0
    seen_keys = set()
    duplicate_keys = []

    for batch in dataloader:
        images = batch["images"].to(device)
        question_ids = batch["question_ids"].to(device)
        question_mask = batch["question_mask"].to(device)
        gt_answers = batch.get("answer_texts", batch.get("answers"))
        if gt_answers is None:
            raise KeyError(
                "Batch has neither 'answer_texts' nor 'answers', check the "
                "SLAKE dataset __getitem__ / collate_fn key name."
            )

        # Full model prediction
        pred_full = decode_fn(model, images, question_ids, question_mask, batch["question_texts"])

        # Ablated prediction: zero out the visual FSRU contribution via a
        # forward hook on fsru_to_text, then restore immediately after.
        handle = model.fsru_to_text.register_forward_hook(_zero_visual_fsru_hook(n_img_tokens))
        pred_ablated = decode_fn(model, images, question_ids, question_mask, batch["question_texts"])
        handle.remove()

        for i in range(images.size(0)):
            question_text = batch["question_texts"][i]
            gt = _normalize(gt_answers[i])
            full_pred_norm = _normalize(pred_full[i])
            ablated_pred_norm = _normalize(pred_ablated[i])

            image_item = dataloader.dataset.data[dataloader.dataset.valid_indices[flat_idx]]
            image_path = dataloader.dataset._resolve_image_path(image_item)

            unique_key = f"{image_path}||{question_text}"
            if unique_key in seen_keys:
                duplicate_keys.append(unique_key)
            seen_keys.add(unique_key)

            records[flat_idx] = {
                "dataset_index": flat_idx,
                "unique_key": unique_key,
                "image": images[i].cpu(),
                "image_path": image_path,
                "question": question_text,
                "ground_truth": gt_answers[i],
                "pred_with_fsru": pred_full[i],
                "pred_without_fsru": pred_ablated[i],
                "full_correct": full_pred_norm == gt,
                "ablated_correct": ablated_pred_norm == gt,
            }
            flat_idx += 1

        if max_examples is not None and flat_idx >= max_examples:
            break

    if duplicate_keys:
        print(f"WARNING: {len(duplicate_keys)} duplicate (image, question) keys "
              f"encountered while scanning the dataloader itself (unrelated to "
              f"the success/failure split): {duplicate_keys[:5]}")
    else:
        print("[collect_predictions] no duplicate (image, question) pairs found in the scanned data")

    n_full_correct = sum(r["full_correct"] for r in records.values())
    n_ablated_correct = sum(r["ablated_correct"] for r in records.values())
    print(f"[collect_predictions] scanned {len(records)} examples | "
          f"full model correct: {n_full_correct} | ablated model correct: {n_ablated_correct}")

    return records


def select_disjoint_success_and_failure(records, top_k=6):
    """
    Partitions the single prediction cache into disjoint success and
    failure example sets.

    Success: FSRU (full model) is correct AND the ablated model is wrong.
    Failure: FSRU (full model) is wrong AND the ablated model is correct.

    These predicates are mutually exclusive for any single record, so the
    two returned lists are disjoint by construction. We additionally assert
    this explicitly before returning, so any future refactor that breaks
    the invariant fails loudly instead of silently producing duplicates.
    """
    success = [r for r in records.values() if r["full_correct"] and not r["ablated_correct"]]
    failure = [r for r in records.values() if (not r["full_correct"]) and r["ablated_correct"]]

    success_ids = {r["dataset_index"] for r in success}
    failure_ids = {r["dataset_index"] for r in failure}
    overlap = success_ids & failure_ids
    assert not overlap, (
        f"Success and failure sets overlap on dataset indices {overlap}. "
        f"This should be mathematically impossible given the predicates used; "
        f"if this fires, check that 'records' was not mutated between calls."
    )

    print(f"[selection] candidate successes: {len(success)} | candidate failures: {len(failure)}")

    success = success[:top_k]
    failure = failure[:top_k]

    print(f"[selection] selected success dataset indices: {[r['dataset_index'] for r in success]}")
    print(f"[selection] selected failure dataset indices: {[r['dataset_index'] for r in failure]}")

    # Final, authoritative disjointness check on the actually-selected sets
    selected_success_keys = {r["unique_key"] for r in success}
    selected_failure_keys = {r["unique_key"] for r in failure}
    final_overlap = selected_success_keys & selected_failure_keys
    assert not final_overlap, (
        f"Selected success and failure examples overlap: {final_overlap}"
    )
    print("[selection] verified: success and failure example sets are disjoint")

    return success, failure


