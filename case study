# 4. HIGH-READABILITY PLOTTING (AAAI-ready)
# ------------------------------------------------------------
def _wrap(text, width=42):
    return "\n".join(textwrap.wrap(str(text), width=width))


def plot_examples(cases, title, save_path, ncols_max=3):
    """
    Each example gets its OWN pair of axes: one for the image, one purely
    for the caption text below it. Using ax.set_title() for a long,
    multi-line caption is fragile, the title's height depends on font size
    and wrap width, and if it grows taller than the reserved hspace it
    bleeds into the image above it (this was the cause of the text/image
    overlap in the previous version). A dedicated text-only axes has no
    such failure mode: its height is fixed by the GridSpec row, and text
    that would overflow it is simply clipped inside that row rather than
    drawn on top of the neighboring image.
    """
    n = len(cases)
    assert n > 0, f"No cases to plot for '{title}'."

    ncols = min(n, ncols_max)
    nrows = int(np.ceil(n / ncols))

    # Two GridSpec rows per example row: image row, then caption row.
    # height_ratios controls how much vertical space each gets.
    fig = plt.figure(figsize=(5.2 * ncols, 5.0 * nrows))
    gs = fig.add_gridspec(
        nrows=2 * nrows,
        ncols=ncols,
        height_ratios=[3.2, 2.0] * nrows,
        hspace=0.15,
        wspace=0.35,
    )

    for idx, case in enumerate(cases):
        pair_row, c = divmod(idx, ncols)
        img_ax = fig.add_subplot(gs[2 * pair_row, c])
        txt_ax = fig.add_subplot(gs[2 * pair_row + 1, c])

        img = case["image"].permute(1, 2, 0).numpy()
        img = (img - img.min()) / (img.max() - img.min() + 1e-8)
        img_ax.imshow(img)
        img_ax.axis("off")

        caption = (
            f"Q: {_wrap(case['question'], 34)}\n\n"
            f"GT: {_wrap(case['ground_truth'], 34)}\n"
            f"With FSRU: {_wrap(case['pred_with_fsru'], 34)}\n"
            f"Without FSRU: {_wrap(case['pred_without_fsru'], 34)}"
        )
        txt_ax.axis("off")
        txt_ax.text(
            0.0, 1.0, caption,
            transform=txt_ax.transAxes,
            fontsize=12.5,
            ha="left", va="top",
            linespacing=1.4,
        )

    # Hide any unused axes pairs
    for idx in range(n, nrows * ncols):
        pair_row, c = divmod(idx, ncols)
        fig.add_subplot(gs[2 * pair_row, c]).axis("off")
        fig.add_subplot(gs[2 * pair_row + 1, c]).axis("off")

    fig.suptitle(title, fontsize=15, y=0.995)
    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    plt.show()
    print(f"Saved: {save_path}")


