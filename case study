# 6. EMBEDDING-SPACE VISUALIZATION (t-SNE, unchanged logic)
# ------------------------------------------------------------
@torch.no_grad()
def plot_embedding_tsne(model, dataloader, device, n_batches=15,
                         save_path="fsru_tsne.png", perplexity=30):
    from sklearn.manifold import TSNE

    model.eval()
    pre_feats, post_feats, labels = [], [], []

    for step, batch in enumerate(dataloader):
        if step >= n_batches:
            break
        images = batch["images"].to(device)
        question_ids = batch["question_ids"].to(device)
        question_mask = batch["question_mask"].to(device)
        answer_ids = batch["answer_ids"].to(device)

        _ = model(images=images, question_ids=question_ids, question_mask=question_mask,
                   answer_ids=answer_ids, question_texts=batch["question_texts"])

        pre = model.fsru._debug_img_pre_fft.mean(dim=(1, 2))
        post = model.fsru._debug_img_post_fft.mean(dim=1)

        pre_feats.append(pre.cpu().numpy())
        post_feats.append(post.cpu().numpy())
        if "answer_type" in batch:
            labels.extend(list(batch["answer_type"]))
        elif "answer_types" in batch:
            labels.extend(list(batch["answer_types"]))

    pre_feats = np.concatenate(pre_feats)
    post_feats = np.concatenate(post_feats)
    labels = np.array(labels) if labels else np.zeros(len(pre_feats))
    print(f"[t-SNE] pooled {len(pre_feats)} real SLAKE val samples")

    pre_2d = TSNE(n_components=2, perplexity=perplexity, random_state=SEED).fit_transform(pre_feats)
    post_2d = TSNE(n_components=2, perplexity=perplexity, random_state=SEED).fit_transform(post_feats)

    fig, axes = plt.subplots(1, 2, figsize=(11, 5))
    for lbl in sorted(set(labels.tolist())):
        mask = labels == lbl
        axes[0].scatter(pre_2d[mask, 0], pre_2d[mask, 1], s=8, label=str(lbl), alpha=0.6)
        axes[1].scatter(post_2d[mask, 0], post_2d[mask, 1], s=8, label=str(lbl), alpha=0.6)
    axes[0].set_title("Pre-FFT image token embeddings (SLAKE)")
    axes[1].set_title("Post-FFT image token embeddings (SLAKE)")
    axes[1].legend(fontsize=8, loc="best")
    for ax in axes:
        ax.set_xticks([]); ax.set_yticks([])
    plt.tight_layout()
    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    plt.show()
    print(f"Saved: {save_path}")


