# 5. 2D FREQUENCY-DOMAIN SPECTRUM (unchanged logic, uses the same model)
# ------------------------------------------------------------
@torch.no_grad()
def plot_frequency_spectrum(model, dataloader, device, sample_idx=0, n_examples=3,
                             save_path="fsru_frequency_spectrum.png"):
    model.eval()
    fig, axes = plt.subplots(n_examples, 3, figsize=(11, 3.3 * n_examples))
    if n_examples == 1:
        axes = axes[None, :]

    it = iter(dataloader)
    for row in range(n_examples):
        batch = next(it)
        images = batch["images"].to(device)
        question_ids = batch["question_ids"].to(device)
        question_mask = batch["question_mask"].to(device)
        answer_ids = batch["answer_ids"].to(device)

        _ = model(images=images, question_ids=question_ids, question_mask=question_mask,
                   answer_ids=answer_ids, question_texts=batch["question_texts"])

        pre = model.fsru._debug_img_pre_fft[sample_idx]
        post = model.fsru._debug_img_post_fft[sample_idx].reshape(14, 14, -1)

        pre_np = pre.mean(dim=-1).cpu().numpy()
        post_np = post.mean(dim=-1).cpu().numpy()

        pre_spec = np.log1p(np.abs(np.fft.fftshift(np.fft.fft2(pre_np))))
        post_spec = np.log1p(np.abs(np.fft.fftshift(np.fft.fft2(post_np))))
        diff_spec = post_spec - pre_spec

        axes[row, 0].imshow(pre_spec, cmap="viridis")
        axes[row, 0].set_title("Input spectrum (log-mag)" if row == 0 else "")
        axes[row, 1].imshow(post_spec, cmap="viridis")
        axes[row, 1].set_title("Filtered spectrum (log-mag)" if row == 0 else "")
        im2 = axes[row, 2].imshow(diff_spec, cmap="coolwarm",
                                   vmin=-np.abs(diff_spec).max(), vmax=np.abs(diff_spec).max())
        axes[row, 2].set_title("Delta (red=amplified, blue=suppressed)" if row == 0 else "")
        for ax in axes[row]:
            ax.axis("off")

    fig.colorbar(im2, ax=axes[:, 2], shrink=0.7, label="log-magnitude delta")
    plt.suptitle("FSRU learned frequency response, SLAKE (center = low freq, edges = high freq)")
    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    plt.show()
    print(f"Saved: {save_path}")


